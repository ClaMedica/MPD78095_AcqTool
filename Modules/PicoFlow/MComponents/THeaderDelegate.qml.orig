import QtQuick 2.5
import QtQuick.Controls 1.1
import QtQuick.Window 2.2
import QtQuick.Layouts 1.1
import MComponents 1.0
Rectangle{
    id:rechead
    property int sortCol:rootTable.sortIndicatorColumn
    property bool sortDir:rootTable.sortIndicatorOrder
    property var itemData:Item{
        property bool selected:false
        property int column:0
        property int row:0
        property int elideMode:0
        property string value:"ciao"
    }
    //Component.onCompleted:console.log(rootInfoBox.title,"Creato header",this,l,img,itemData.column,itemData.value,"#")
    //Component.onDestruction: console.log(rootInfoBox.title,"Distrutto header",this,l,img,itemData.column,itemData.value,"#")
    height:layout.dimensionOf("THF")
    color:itemData.column%2?layout.value("THC1"):layout.value("THC2")
    onSortColChanged: updateArrow()
    onSortDirChanged:updateArrow()
    clip:true
    function updateArrow(){
        //console.log(sortCol,sortDir)
        if(sortCol===itemData.column)
            img.rotation=sortDir?-90:90
        else
            img.rotation=0
    }
    Text {
        id:l
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left:img.right
        anchors.right:img.left
        anchors.margins: layout.value("Margin")

        color: "white"
        text: itemData.value
        font.bold: true
        font.pixelSize: layout.dimensionOf("F2")
        horizontalAlignment: Text.AlignLeft
        verticalAlignment: Text.AlignVCenter

    }


    Image{
        id:img
        anchors.left:parent.left
        anchors.verticalCenter: parent.verticalCenter
        anchors.margins: layout.value("Margin")
        height:layout.dimensionOf("THF")*0.6
        width:sortEnabled?height:0
        source:"qrc:/Images/arrow.png"
        rotation: 0
        visible:sortEnabled
        Behavior on rotation {NumberAnimation{duration:200}}
    }
}
