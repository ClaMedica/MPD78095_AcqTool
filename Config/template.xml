<?xml version="1.0" encoding="UTF-8"?>
<Doppler>
<!-- plot name -->
<Graph name="doppler">
<!-- Axis maximum absolute ratings -->
<Axis xAbsoluteMax="1" 
		xAbsoluteMin="0" 	
		yAbsoluteMax="0.1" 
		yAbsoluteMin="-0.1"
		/>
<!-- notches properties -->
<Notches xNotchLenght="5" 
			yNotchLenght="5"
			/>
<!-- Grid properties -->
<Grid xGridLines="5" 
		yGridLines="3" 
	   xSubGridLines="2" 
	   ySubGridLines="2"
		gridLineWidth="3"
		subGridLineWidth="1"
		/>
<!-- colors -->
<Colors gridLineColor="blue"
		  subGridLineColor="green"
		  />
<!-- Axis -->
<Axis 
		
      xALDecimalsMaj="0"
      xALDecimalsMin="0"
      xALDateTimeformatMaj="mm:ss.zzz"
      xALDateTimeformatMin="ss.zzz"
    
      xALMajFontFamily="ubuntu"
      xALMajFontColor="white"
      xALMajFontSize="12"
      xALMajTextDist="5"
      xALMajTextVisible="1"
      xALMajOpacity="1.0"
    
      xALMinFontFamily="ubuntu"
      xALMinFontColor="#777777"
      xALMinFontSize="10"
      xALMinTextDist="2"
      xALMinTextVisible="1"
      xALMinOpacity="1.0"
      xAUOM="[mm:ss.zzz]"
      xAUOMVisible="1"
      xAFontUOMFamily="ubuntu"
      xAFontUOMColor="#CCCCCC"
      xAFontUOMSize="14"
      xATextUOMDist="10"
      xAOpacityUOM="1.0"
      xAUOMRotation="0"
    
     yALDecimalsMaj="0"
      yALDecimalsMin="0"
      yALDateTimeformatMaj="mm:ss.zzz"
      yALDateTimeformatMin="ss.zzz"
    
      yALMajFontFamily="ubuntu"
      yALMajFontColor="white"
      yALMajFontSize="12"
      yALMajTextDist="5"
      yALMajTextVisible="1"
      yALMajOpacity="1.0"
    
      yALMinFontFamily="ubuntu"
      yALMinFontColor="#777777"
      yALMinFontSize="10"
      yALMinTextDist="2"
      yALMinTextVisible="1"
      yALMinOpacity="1.0"
      yAUOM="[mm:ss.zzz]"
      yAUOMVisible="1"
      yAFontUOMFamily="ubuntu"
      yAFontUOMColor="#CCCCCC"
      yAFontUOMSize="14"
      yATextUOMDist="10"
      yAOpacityUOM="1.0"
      yAUOMRotation="90"
		  />
<TimeCursor enableTimeCursor="0"/>
<Zoom zoomSpeed="0.1"/>
</Graph>

</Doppler>
