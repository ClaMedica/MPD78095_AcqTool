        <file>Config_User.xml</file>
        <file>Config_Layout.xml</file>
        <file>markers.xml</file>
        <file>ParAna.xml</file>
        <file>Config_User_pico.xml</file>
        <file>Config_Grafic.xml</file>
        <file>Config_Grafic_pico.xml</file>
        <file>Config_User_Prop.xml</file>
        <file>Config_Printer_Desktop.xml</file>
        <file>Config_Layout_Pico.xml</file>
        <file>Config_Grafic_mac.xml</file>
    </qresource>
    <qresource prefix="/Dialog">
        <file>VolResDlg.qml</file>
        <file>ExitDlg.qml</file>
        <file>WarningDlg.qml</file>
    </qresource>
</RCC>
