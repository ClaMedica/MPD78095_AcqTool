<Configuration>
        <AutomaticFlow>
        <Auto
            label="Automatic flow"
            type="CheckBox"
            unit=""
            value="true"
        />
        <AutoStarts>
                <Step>
                        <chanType
                        label="Channel Type"
                        type="TextField"
                        unit=""
                        value="VBT"
                        />
                        <num
                        label="Number"
                        type="TextField"
                        unit=""
                        value="1"
                        />
                        <repeat
                        label="Repeat"
                        type="CheckBox"
                        unit=""
                        value="0"
                        />
                        <bufferSize
                        label="Buffer Size"
                        type="TextField"
                        unit=""
                        value="50"
                        />
                        <enabled
                        label="Enabled"
                        type="CheckBox"
                        unit=""
                        value="1"
                        />
                        <Amplitude>
                                <min
                                label="Minimum"
                                type="TextField"
                                unit="g"
                                value="2"
                                />
                                <max
                                label="Maximum"
                                type="TextField"
                                unit="g"
                                value="15"
                                />
                        </Amplitude>
                        <Duration>
                                <min
                                label="Minimum"
                                type="TextField"
                                unit="sec"
                                value="10"
                                />
                        </Duration>
                        <Width
                           label="width track"
                           type="TextField"
                           unit=""
                           value="1"
                        />
                        <Tick
                            label="tick"
                            type="TextField"
                            unit=""
                            value="3"
                        />
                        <Color
                            label="color track"
                            type="ColorBox"
                            unit=""
                            value="black"
                        />
                </Step>
        </AutoStarts>
        <AutoStops>
                <Stationary>
                        <chanType
                        label="Channel Type"
                        type="TextField"
                        unit=""
                        value="QBT"
                        />
