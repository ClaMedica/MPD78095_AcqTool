<Configuration label="Configuration">
<Versione
    label="1"
    visible="false"
/>
<pesoBeaker label="pesoBeaker" value="70" visible = "false"/>
<AutomaticFlow label="Automatic Flow">
    <Auto
        label="Automatic flow"
        type="CheckBox"
        unit=""
        value="false"
        visible="false"
    />
    <AutoStarts label="Automatic Flow Start Time">
            <Amplitude label="Amplitude">
                <min
                    label="Minimum"
                    type="SpinBox"
                    unit="ml"
                    dt="real"
                    value="1"
                    model="2#1#1#0#"
                 />
                 <max
                    label="Maximum"
                    type="TextField"
                    unit="ml/sec"
                    value="150"
                    alfanum="false"
                    visible="false"
                 />
            </Amplitude>
            <Duration label="Duration">
                <min
                    label="Minimum"
                    type="SpinBox"
                    dt="real"
                    unit="sec"
                    value="2"
                    model="5#1#1#0#"
                />
            </Duration>
            <chanType
                type="TextField"
                unit=""
                label="Channel Type"
                value="VV"
                visible = "false"
             />
             <num
                label="Number"
                type="TextField"
                unit=""
                value="1"
                visible = "false"
             />
    </AutoStarts>
    <AutoStops label="Automatic Flow Stop Time">
            <Value label="Value" visible = "false">
                <min
                    label="Minimum"
                    type="TextField"
                    unit="ml/sec"
                    value="-2"
                    alfanum="false"
                />
                <max
                    label="Maximum"
                    type="TextField"
                    unit="ml/sec"
                    value="2"
                    alfanum="false"
                />
            </Value>
            <Duration label="Duration">
                <min
                    label="Minimum"
                    type="SpinBox"
                    dt="real"
                    unit="sec"
                    value="20"
                    model="95#5#1#0#"
                />
           </Duration>
           <chanType
                 label="Channel Type"
                 type="TextField"
                 unit=""
                 value="Q"
                 visible = "false"
             />
             <num
                 label="Number"
                 type="TextField"
                 unit=""
                 value="1"
                 visible = "false"
             />
    </AutoStops>
</AutomaticFlow>
<ChannelsAbilitation label="Channels Abilitation">
        <Emg
            label="EMG"
            type="CheckBox"
            unit=""
            value="true"
            visible = "true"
        />
</ChannelsAbilitation>
</Configuration>
