                        label="Number"
                        type="TextField"
                        unit=""
                        value="1"
                        />
                        <repeat
                        label="Repeat"
                        type="CheckBox"
                        unit=""
                        value="0"
                        />
                        <Value>
                                <min
                                label="Minimum"
                                type="TextField"
                                unit="ml/sec"
                                value="-1"
                                />
                                <max
                                label="Maximum"
                                type="TextField"
                                unit="ml/sec"
                                value="1"
                                />
                        </Value>
                        <Duration>
                                <min
                                label="Minimum"
                                type="TextField"
                                unit="sec"
                                value="300"
                                />
                                <max
                                label="Maximum"
                                type="TextField"
                                unit="sec"
                                value="300"
                                />
                        </Duration>
                       </Stationary>
        </AutoStops>
        </AutomaticFlow>
        <Supervisor>
                <Visible
                label="Visible"
                type="CheckBox"
                unit=""
