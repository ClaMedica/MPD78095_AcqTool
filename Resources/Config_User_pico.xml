<Configuration>
    <AutomaticFlow>
        <Auto
            label="Automatic flow"
            type="CheckBox"
            unit=""
            value="true"
            visible="false"
        />
        <Loop
            label="Automatic loop"
            type="CheckBox"
            unit=""
            value="false"
            visible="false"
        />
        <AutoStarts>
                <Amplitude>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="g"
                        value="2"
                     />
                     <max
                        label="Maximum"
                        type="TextField"
                        unit="g"
                        value="15"
                     />
                </Amplitude>
                <Duration>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="sec"
                        value="10"
                    />
                </Duration>
                <chanType
                    type="TextField"
                    unit=""
                    label="Channel Type"
                    value="VV"
                    visible = "false"
                 />
                 <num
                    label="Number"
                    type="TextField"
                    unit=""                    
                    value="1"
                    visible = "false"
                 />
        </AutoStarts>
        <AutoStops>
                <Value>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="ml/sec"
                        value="-1"
                    />
                    <max
                        label="Maximum"
                        type="TextField"
                        unit="ml/sec"
                        value="1"
                    />
                </Value>
                <Duration>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="sec"
                        value="300"
                    />

               </Duration>
               <chanType
                     label="Channel Type"
                     type="TextField"
                     unit=""
                     value="Q"
                     visible = "false"
                 />
                 <num
                     label="Number"
                     type="TextField"
                     unit=""
                     value="1"
                     visible = "false"
                 />
        </AutoStops>
    </AutomaticFlow>
    <ChannelsAbilitation>
            <Emg
                label="EMG"
                type="CheckBox"
                unit=""
                value="true"
            />

         </ChannelsAbilitation>
        <ChannelsProp>
            <VV>
            <thick
                    label="thick"
                    type="TextField"
                    unit=""
                    value="3"
                />
                <color
                    label="color track"
                    type="ColorBox"
                    unit=""
                    value="black"
                />
                <yAutoScale
                    label="Auto Range"
                    type="CheckBox"
                    unit=""
                    value="1"
                />
                <Range
                    label="Range"
                    type="SpinBox"
                    dt="real"
                    unit="ml"
                    model="500#50#5#0#"
                    value="200"
                />

            </VV>
            <Q>
            <thick
                    label="thick"
                    type="TextField"
                    unit=""
                    value="3"
                />
                <color
                    label="color track"
                    type="ColorBox"
                    unit=""
                    value="red"
                />
                <yAutoScale
                    label="Auto Range"
                    type="CheckBox"
                    unit=""
                    value="1"
                />
                <Range
                    label="Range"
                    type="SpinBox"
                    dt="real"
                    unit="ml/sec"
                    model="100#25#25#0#"
                    value="50"
                />

            </Q>
            <EMG>
            <thick
                    label="thick"
                    type="TextField"
                    unit=""
                    value="3"
                />
                <color
                    label="color track"
                    type="ColorBox"
                    unit=""
                    value="red"
                />
                <yAutoScale
                    label="Auto Range"
                    type="CheckBox"
                    unit=""
                    value="1"
                />
                <Range
                    label="Range"
                    type="SpinBox"
                    dt="real"
                    unit="uV"
                    model="5000#500#500#0#"
                    value="1000"
                />

            </EMG>
        </ChannelsProp>

        <AnalysisSettings>
            <AutoPrint
                label="Automatic Print"
                type="CheckBox"
                unit=""
                value="true"
            />
            <Siroky
                label="Siroky"
                type="CheckBox"
                unit=""
                value="false"
            />
            <Liverpool
                label="Liverpool"
                type="CheckBox"
                unit=""
                value="false"
            />
            <PrinterMode
                label="Print Landscape Mode"
                type="CheckBox"
                unit=""
                value="false"
            />
        </AnalysisSettings>

</Configuration>
