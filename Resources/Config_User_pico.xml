        </AutoStarts>
        <AutoStops>
                <Value>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="ml/sec"
                        value="-1"
                    />
                    <max
                        label="Maximum"
                        type="TextField"
                        unit="ml/sec"
                        value="1"
                    />
                </Value>
                <Duration>
                    <min
                        label="Minimum"
                        type="TextField"
