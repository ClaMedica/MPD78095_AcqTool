<Configuration>
    <AutomaticFlow>
        <Auto
            label="Automatic flow"
            type="CheckBox"
            unit=""
            value="true"
        />
        <AutoStarts>
                <Amplitude>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="g"
                        value="2"
                     />
                     <max
                        label="Maximum"
                        type="TextField"
                        unit="g"
                        value="15"
                     />
                </Amplitude>
                <Duration>
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="sec"
                        value="10"
                    />
