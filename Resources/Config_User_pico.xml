<Configuration label="Configuration">
    <AutomaticFlow label="Automatic Flow">
        <Auto
            label="Automatic flow"
            type="CheckBox"
            unit=""
            value="false"
            visible="false"
        />
        <Loop
            label="Automatic loop"
            type="CheckBox"
            unit=""
            value="false"
            visible="false"
            pesoBeaker="70"
        />
        <AutoStarts label="Auto Starts">
                <Amplitude label="Amplitude">
                    <min
                        label="Minimum"
                        type="SpinBox"
                        unit="ml"
                        dt="real"
                        value="1"
                        model="2#1#1#0#"
                     />
                     <max
                        label="Maximum"
                        type="TextField"
                        unit="ml/sec"
                        value="150"
                        alfanum="false"
                        visible="false"
                     />
                </Amplitude>
                <Duration label="Duration">
                    <min
                        label="Minimum"
                        type="SpinBox"
                        dt="real"
                        unit="sec"
                        value="2"
                        model="5#1#1#0#"
                    />
                </Duration>
                <chanType
                    type="TextField"
                    unit=""
                    label="Channel Type"
                    value="VV"
                    visible = "false"
                 />
                 <num
                    label="Number"
                    type="TextField"
                    unit=""                    
                    value="1"
                    visible = "false"
                 />
        </AutoStarts>
        <AutoStops label="Auto Stops">
                <Value label="Value" visible = "false">
                    <min
                        label="Minimum"
                        type="TextField"
                        unit="ml/sec"
                        value="-2"
                        alfanum="false"
                    />
                    <max
                        label="Maximum"
                        type="TextField"
                        unit="ml/sec"
                        value="2"
                        alfanum="false"
                    />
                </Value>
                <Duration label="Duration">
                    <min
                        label="Minimum"
                        type="SpinBox"
                        dt="real"
                        unit="sec"
                        value="20"
                        model="95#5#5#0#"
                    />
               </Duration>
               <chanType
                     label="Channel Type"
                     type="TextField"
                     unit=""
                     value="Q"
                     visible = "false"
                 />
                 <num
                     label="Number"
                     type="TextField"
                     unit=""
                     value="1"
                     visible = "false"
                 />
        </AutoStops>
    </AutomaticFlow>
    <ChannelsAbilitation label="Channels Abilitation">
            <Emg
                label="EMG"
                type="CheckBox"
                unit=""
                value="true"
            />
    </ChannelsAbilitation>
        <ChannelsProp label="Channels Prop">
            <VV>
            <thick
                    label="thick"
                    type="TextField"
                    unit=""
                    value="3"
                    alfanum="false"
                />
                <color
                    label="color track"
                    type="ColorBox"
                    unit=""
                    value="black"
                />
                <yAutoScale
                    label="Auto Range"
                    type="CheckBox"
                    unit=""
                    value="true"
                />
                <Range
                    label="Range"
                    type="SpinBox"
                    dt="real"
                    unit="ml"
                    model="2000#200#100#0#"
                    value="200"
                />

            </VV>
            <Q>
                <thick
                    label="thick"
                    type="TextField"
                    unit=""
                    value="3"
                    alfanum="false"
                />
                <color
                    label="color track"
                    type="ColorBox"
                    unit=""
                    value="red"
                />
                <yAutoScale
                    label="Auto Range"
                    type="CheckBox"
                    unit=""
                    value="true"
                />
                <Range
                    label="Range"
                    type="SpinBox"
                    dt="real"
                    unit="ml/sec"
                    model="100#10#10#0#"
                    value="50"
                />

            </Q>
            <EMG>
            <thick
                    label="thick"
                    type="TextField"
                    unit=""
                    value="3"
                    alfanum="false"
                />
                <color
                    label="color track"
                    type="ColorBox"
                    unit=""
                    value="red"
                />
                <yAutoScale
                    label="Auto Range"
                    type="CheckBox"
                    unit=""
                    value="true"
                />
                <Range
                    label="Range"
                    type="SpinBox"
                    dt="real"
                    unit="uV"
                    model="5000#500#500#0#"
                    value="1000"
                />

            </EMG>
        </ChannelsProp>
</Configuration>
